{{#features}}
<li class="item feature-card" id="templateWreck">
  <div class="feature-header">
    <h3 class="title-feature">
      <i class="fas fa-ship feature-icon"></i>
      {{Name}}
    </h3>
    <div id="select-features-list">
      <span class="select-features tag-type"><i class="fas fa-anchor"></i> {{Type}}</span>
      <span class="select-features tag-flag"><i class="fas fa-flag"></i> {{Flag}}</span>
      <span class="select-features tag-status"><i class="fas fa-recycle"></i> {{Status}}</span>
    </div>
  </div>

  <div class="feature-details">
    <div class="detail-item"><i class="fas fa-map-marker-alt detail-icon"></i>
      <div><span class="detail-label">Position</span><span class="detail-value">{{Position}}</span></div>
    </div>
    <div class="detail-item"><i class="fas fa-globe detail-icon"></i>
      <div><span class="detail-label">Name</span><span class="detail-value">{{name}}</span></div>
    </div>
    <div class="detail-item"><i class="fas fa-globe detail-icon"></i>
      <div><span class="detail-label">Latitude</span><span class="detail-value">{{latitude}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-globe detail-icon"></i>
      <div><span class="detail-label">Longitude</span><span class="detail-value">{{longitude}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-crosshairs detail-icon"></i>
      <div><span class="detail-label">Système horizontal</span><span class="detail-value">{{Horizontal}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-info-circle detail-icon"></i>
      <div><span class="detail-label">Catégorie épave</span><span class="detail-value">{{wreck_cate}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-water detail-icon"></i>
      <div><span class="detail-label">Profondeur (m)</span><span class="detail-value">{{depth}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-info detail-icon"></i>
      <div><span class="detail-label">Qualité profondeur</span><span class="detail-value">{{Depth_qual}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-water detail-icon"></i>
      <div><span class="detail-label">Hauteur d’eau</span><span class="detail-value">{{water_dept}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-exchange-alt detail-icon"></i>
      <div><span class="detail-label">Couverture marée</span><span class="detail-value">{{water_leve}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-long-arrow-alt-down detail-icon"></i>
      <div><span class="detail-label">Niveau vertical</span><span class="detail-value">{{wertical_d}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-ruler-horizontal detail-icon"></i>
      <div><span class="detail-label">Longueur</span><span class="detail-value">{{Length}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-ruler-vertical detail-icon"></i>
      <div><span class="detail-label">Largeur</span><span class="detail-value">{{Width}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-water detail-icon"></i>
      <div><span class="detail-label">Tirant d’eau</span><span class="detail-value">{{Draught}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-weight-hanging detail-icon"></i>
      <div><span class="detail-label">Tonnage</span><span class="detail-value">{{Tonnage}} {{Tonnage_ty}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-eye-slash detail-icon"></i>
      <div><span class="detail-label">Visibilité</span><span class="detail-value">{{Conspic_vi}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-radar detail-icon"></i>
      <div><span class="detail-label">Radar</span><span class="detail-value">{{Conspic_ra}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-calendar-times detail-icon"></i>
      <div><span class="detail-label">Date naufrage</span><span class="detail-value">{{Date_sunk}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-file-alt detail-icon"></i>
      <div><span class="detail-label">Source originale</span><span class="detail-value">{{Original_s}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-eye detail-icon"></i>
      <div><span class="detail-label">Dernière détection</span><span class="detail-value">{{Last_detec}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-edit detail-icon"></i>
      <div><span class="detail-label">Dernière mise à jour</span><span class="detail-value">{{Last_amend}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-database detail-icon"></i>
      <div><span class="detail-label">ID Viewer</span><span class="detail-value">{{Mviewerid}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-ship detail-icon"></i>
      <div><span class="detail-label">Commentaires</span><span class="detail-value">{{Circumstan}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-search detail-icon"></i>
      <div><span class="detail-label">Observation</span><span class="detail-value">{{Surveying_}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-info-circle detail-icon"></i>
      <div><span class="detail-label">Commentaires généraux</span><span class="detail-value">{{General_co}}</span></div>
    </div>
  </div>
</li>


<style>
	/* Définition des variables CSS */
	:root {
		--primary-color: #161A30;
		--secondary-color: #4D79B8;
		--accent-color: #5DB0C3;
		--light-bg: #F8F9FA;
		--dark-text: #2D3748;
		--light-text: #718096;
		--border-radius: 12px;
		--box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		--font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
	}

	/* Style général */
	.item.feature-card {
		background-color: white;
		border-radius: var(--border-radius);
		box-shadow: var(--box-shadow);
		padding: 20px;
		margin-bottom: 20px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.item.feature-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
	}

	.feature-header {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 20px;
		padding-bottom: 15px;
		border-bottom: 1px solid #e2e8f0;
	}

	.title-feature {
		color: var(--primary-color);
		font-family: var(--font-family);
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.feature-icon {
		color: var(--secondary-color);
		font-size: 1.1em;
	}

	#select-features-list {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.select-features {
		background-color: var(--primary-color);
		padding: 6px 12px;
		color: white;
		font-size: 0.75rem;
		font-family: var(--font-family);
		border-radius: 20px;
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.select-features i {
		font-size: 0.7em;
	}

	.feature-details {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 15px;
	}

	.detail-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px;
		background-color: var(--light-bg);
		border-radius: var(--border-radius);
	}

	.detail-icon {
		color: var(--secondary-color);
		font-size: 1.2em;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: rgba(77, 121, 184, 0.1);
		border-radius: 50%;
	}

	.detail-label {
		display: block;
		font-family: var(--font-family);
		font-size: 0.75rem;
		color: var(--light-text);
		margin-bottom: 2px;
	}

	.detail-value {
		display: block;
		font-family: var(--font-family);
		font-size: 0.9rem;
		color: var(--dark-text);
		font-weight: 500;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.feature-details {
			grid-template-columns: 1fr;
		}
	}

	/* Ajout des animations */
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.feature-card {
		animation: fadeIn 0.4s ease-out forwards;
	}
	.source-footer {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--light-text);
}

.source-footer i {
    color: var(--secondary-color);
}
.tag-region {
  background-color: #1E90FF; /* Bleu clair */
}

.tag-province {
  background-color: #20B2AA; /* Vert-bleu */
}

.tag-commune {
  background-color: #FF8C00; /* Orange foncé */
}

.tag-eez {
  background-color: #2b8cbe; /* bleu océan */
}

.tag-sea {
  background-color: #74c476; /* vert mer */
}

.tag-country {
  background-color: #fdae6b; /* orange doux */
}
.tag-type {
  background-color: #006d77;
}
.tag-flag {
  background-color: #ffb703;
}
.tag-status {
  background-color: #ef476f;
}
</style>

<!-- Inclure Font Awesome pour les icônes -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script language="javascript">
  // Votre code JavaScript existant peut rester inchangé
  // Récupération du code_geo de l'entité selectionnée
  var c_geo = [];
  c_geo.push('Abrera');

  // Définition d'une fonction get_wfsdata
  function get_wfsdata(url, args, callback) {
    var qs = {
      "service": "WFS",
      "version": "2.0.0",
      "request": "GetFeature",
      "outputFormat": "application/json"
    };
    $.getJSON(url + $.param($.extend(qs, args)), callback);
  }


</script>

{{/features}}