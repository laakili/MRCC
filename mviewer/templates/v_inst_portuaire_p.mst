{{#features}}
	<li class="item feature-card" id="templateRight">
  <div class="feature-header">
    <h3 class="title-feature">
      <i class="fas fa-map-marker-alt feature-icon"></i>
      {{denomination}}
    </h3>
    <div id="select-features-list">
      <span class="select-features"><i class="fas fa-ship"></i> {{type}}</span>
      <span class="select-features"><i class="fas fa-layer-group"></i> {{categorie}}</span>
      <span class="select-features"><i class="fas fa-layer-group"></i> {{secteur}}</span>
    </div>
    <div id="select-features-list">
      <span class="select-features tag-region"><i class="fas fa-map"></i> {{region_adms}}</span>
      <span class="select-features tag-province"><i class="fas fa-map-marker"></i> {{province}}</span>
      <span class="select-features tag-commune"><i class="fas fa-city"></i> {{commune}}</span>
    </div>

    <div class="feature-details">
    <div class="detail-item">
      <i class="fas fa-user-shield detail-icon"></i>
      <div>
        <span class="detail-label">Surveillance</span>
        <span class="detail-value">{{Surveillan}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-ruler-horizontal detail-icon"></i>
      <div>
        <span class="detail-label">Longueur</span>
        <span class="detail-value">{{longueur}} m</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-water detail-icon"></i>
      <div>
        <span class="detail-label">Profondeur</span>
        <span class="detail-value">{{profondeur}} m</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-draw-polygon detail-icon"></i>
      <div>
        <span class="detail-label">Superficie</span>
        <span class="detail-value">{{superficie}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-road detail-icon"></i>
      <div>
        <span class="detail-label">Voies de communication</span>
        <span class="detail-value">{{voies_comm}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-check-circle detail-icon"></i>
      <div>
        <span class="detail-label">Opérationnel</span>
        <span class="detail-value">{{ops}}</span>
      </div>
    </div>

  </div>

  <div class="source-footer">
    <i class="fas fa-camera"></i>
    <span class="source-text">Source : GeoAi SOLUTIONS OpenData</span>
  </div>
</li>


<style>
	/* Définition des variables CSS */
	:root {
		--primary-color: #161A30;
		--secondary-color: #4D79B8;
		--accent-color: #5DB0C3;
		--light-bg: #F8F9FA;
		--dark-text: #2D3748;
		--light-text: #718096;
		--border-radius: 12px;
		--box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		--font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
	}

	/* Style général */
	.item.feature-card {
		background-color: white;
		border-radius: var(--border-radius);
		box-shadow: var(--box-shadow);
		padding: 20px;
		margin-bottom: 20px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.item.feature-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
	}

	.feature-header {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 20px;
		padding-bottom: 15px;
		border-bottom: 1px solid #e2e8f0;
	}

	.title-feature {
		color: var(--primary-color);
		font-family: var(--font-family);
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.feature-icon {
		color: var(--secondary-color);
		font-size: 1.1em;
	}

	#select-features-list {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.select-features {
		background-color: var(--primary-color);
		padding: 6px 12px;
		color: white;
		font-size: 0.75rem;
		font-family: var(--font-family);
		border-radius: 20px;
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.select-features i {
		font-size: 0.7em;
	}

	.feature-details {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 15px;
	}

	.detail-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px;
		background-color: var(--light-bg);
		border-radius: var(--border-radius);
	}

	.detail-icon {
		color: var(--secondary-color);
		font-size: 1.2em;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: rgba(77, 121, 184, 0.1);
		border-radius: 50%;
	}

	.detail-label {
		display: block;
		font-family: var(--font-family);
		font-size: 0.75rem;
		color: var(--light-text);
		margin-bottom: 2px;
	}

	.detail-value {
		display: block;
		font-family: var(--font-family);
		font-size: 0.9rem;
		color: var(--dark-text);
		font-weight: 500;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.feature-details {
			grid-template-columns: 1fr;
		}
	}

	/* Ajout des animations */
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.feature-card {
		animation: fadeIn 0.4s ease-out forwards;
	}
	.source-footer {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--light-text);
}

.source-footer i {
    color: var(--secondary-color);
}
.tag-region {
  background-color: #1E90FF; /* Bleu clair */
}

.tag-province {
  background-color: #20B2AA; /* Vert-bleu */
}

.tag-commune {
  background-color: #FF8C00; /* Orange foncé */
}

</style>

<!-- Inclure Font Awesome pour les icônes -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script language="javascript">
  // Votre code JavaScript existant peut rester inchangé
  // Récupération du code_geo de l'entité selectionnée
  var c_geo = [];
  c_geo.push('Abrera');

  // Définition d'une fonction get_wfsdata
  function get_wfsdata(url, args, callback) {
    var qs = {
      "service": "WFS",
      "version": "2.0.0",
      "request": "GetFeature",
      "outputFormat": "application/json"
    };
    $.getJSON(url + $.param($.extend(qs, args)), callback);
  }


</script>

{{/features}}