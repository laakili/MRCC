{{#features}}
<br><br>

<li class="item" style="padding-bottom:65px;">
    <div class="titre">{{libelle}}
    </div>

    <div class="soustitre"> Détails :
        <span class="text2"> {{detail}}</span>

    </div>

    <br><br><i style="font-size:20px" class="glyphicon glyphicon-calendar"></i> Date Début: <span
        class="text">{{date_debut}}</span>
    <br><br><i style="font-size:20px" class="glyphicon glyphicon-time"></i> Heure : <span class="text">
        {{heure_debut}}</span>
    <br><br><i style="font-size:20px" class="glyphicon glyphicon-map-marker"></i> Lieu : <span class="text">
        {{lieu}}</span>

    <br><br>


    <div class="soustitre"> Caractéristiques</div>
    <table class="table table-bordered">

        <tbody>

            <tr>
                <th class="title_table">Etendue</th>
                <th>50 KM2</th>
            </tr>

            <tr>
                <td class="title_table">Distance</td>
                <td>120 Miles</td>
            </tr>

            <tr>
                <td class="title_table">Composition chimique</td>
                <td>Plastique</td>
            </tr>
            <tr>
                <td class="title_table">Méthodes de détection</td>
                <td>Surveillance </td>
            </tr>



        </tbody>
    </table>



    <div class="soustitre"> Mesures prises</div>
    <table class="table table-bordered">

        <tbody>

            <tr>
                <th class="title_table">01/04/2024 à 08H00</th>
                <th>Déclaration de la pollution</th>
            </tr>

            <tr>
                <th class="title_table">01/04/2024 à 09H00</th>
                <th>Intervention d'urgence</th>
            </tr>

            <tr>
                <th class="title_table">01/04/2024 à 10H00</th>
                <th>Délimitation de la pollution </th>
            </tr>

            <tr>
                <th class="title_table">01/04/2024 à 11H00</th>
                <th>Élimination de la pollution </th>
            </tr>
            <tr>
                <th class="title_table">01/04/2024 à 11H00</th>
                <th>Évaluation des dommages environnementaux </th>
            </tr>
            <tr>
                <th class="title_table">01/04/2024 à 11H00</th>
                <th>Surveillance et suivi post-nettoyage</th>
            </tr>

        </tbody>
    </table>
<div class="soustitre"> Moyens humains</div>
    <table class="table table-bordered">

        <tbody>

            <tr>
                <th class="title_table">MR</th>
                <th>50</th>
            </tr>

            <tr>
                <td class="title_table">GR</td>
                <td>40</td>
            </tr>

            <tr>
                <td class="title_table">FA</td>
                <td>50</td>
            </tr>
            <tr>
                <td class="title_table">Protection civile</td>
                <td>40 </td>
            </tr>
       <tr>
                <td class="title_table">Autorités locales</td>
                <td>415</td>
            </tr>


        </tbody>
    </table>
    <div class="soustitre"> Moyens matériels</div>
    <table class="table table-bordered">

        <tbody>

            <tr>
                <th class="title_table">Batiments MR</th>
                <th>5</th>
            </tr>

            <tr>
                <td class="title_table">Vedette GR</td>
                <td>40</td>
            </tr>

       


        </tbody>
    </table>

    <div class="btn-update admin operator" id="group-btn-update-event" style="display: none;padding-bottom:5px">
        <button onclick="showPopUp({{id}})"
            style="border-radius: 50rem !important;position:absolute,bottom:10px,display:inline-block"
            id="btn-update-event" class="btn btn-success mt-2 d-flex align-self-center"> <i
                class="fa fa-edit"></i>Modifier </button>
        <button onclick="deleteEvent()" style="border-radius: 50rem !important;display:inline-block"
            class="btn btn-danger mt-2 d-flex align-self-center">
            <i class="fa fa-trash"></i>
            Supprimer </button>
    </div>
    <div class="btn-update btn-update-buffer admin" style="display: none">
        <button onclick="analyse.showPopUp({{id_categorie}})" style="visibility:hidden;border-radius: 50rem !important"
            id="btn-update-buffer" class="btn btn-success mt-2 d-flex align-self-center"> <i
                class="fa fa-edit"></i>Modifier
            Buffer </button>
    </div>
</li>

{{/features}}


<style>
    .text {
        font-size: 14px;
    }

    .text2 {
        font-size: 16px;
    }

    .titre {
        font-size: 22px;
        font-weight: 600;
    }

    .soustitre {
        font-size: 16px;
        padding-top: 10px;
    }

    .pan_title {
        color: #32CD32;
        font-weight: bold;
    }

    .title_table {
        font-weight: bold;
        background-color: var(--bf500);
        color: white !important;
    }
</style>