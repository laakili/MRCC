<!-- Ajouter la bibliothèque Chart.js -->

{{#features}}
	<li class="item" id ="templateRight" >
	
		<div id="select-features-list">
            <span class="select-features">{{Commune}}</span>
            <span class="select-features">{{cercle}}</span>
            <span class="select-features">{{Caidat}}</span>
			<span class="select-features"> {{province}}</span>
			<span class="select-features">{{region_adms}}</span>
			
			
			<!-- Alerte: Chiffres de l'année en cours 
			<p class="warning warning-info{{annee}}">The information displayed represents the current year</p>-->
		</div>

		<div id="user-{{divadmin}}">

		    <!-- L'entité utilise le service -->
			<div class="user-service-oui">
				<div class="service-block-marches">
					<div class="col1">
						<div class="icon-block">
							<img class="icon" src="img/home_b.svg">
						</div>
					</div>
					<div class="service-block-info">
						<p class="number-feature-marches">{{Commune}}</p>
						<p class="text-feature"><span class="glyphicon glyphicon-ok" aria-hidden="true"></span> {{mort}} Morts et 25 Bléssés</p>
					</div>
				</div>
				<!-- Chiffres clés + graphique -->
				
				
				<div class="service-block-number row">
					<div class="col-sm-4">
						<div class="block-grey block-number center">
							<img class="icon" src="img/immeubles.png" width style="width: 40px;">
							<p class="title-number-feature-marches">{{mort}}</p>
							<p class="subtitle-number-feature">Morts</p>
							
						
						</div>
					</div>
					
					<div class="col-sm-8">
						<div class="block-grey block-graph center">
							<div id="idChart">
                                <canvas class="chart" id="graph_deaths" style="height:170px;width: content-box;"></canvas>

							</div>
							<p class="title-chart-feature">Evolution du nombre des morts</p>
								<p class="subtitle-number-feature">Pour la commune touchée</p>
						</div>
					</div>
			 </div>
			</div>




			<div class="service-block-number row">
				<div class="col-sm-4">
					<div class="block-grey block-number center">
						<img class="icon" src="img/blesse.png" width style="width: 40px;">
						<p class="title-number-feature-marches">25</p>
						<p class="subtitle-number-feature">Blessés</p>
						
					</div>
				</div>
				<div class="col-sm-8">
						<div class="block-grey block-graph center">
							<div id="idChart">
                                <canvas class="chart" id="graph_injuries" style="height:170px;width: content-box;"></canvas>
							<p class="title-chart-feature">Evolution du nombre des blessés</p>
								<p class="subtitle-number-feature">Pour la commune touchée</p>
						</div>
					</div>
			</div>

        </div>

			<div class="service-block-number row" style="padding: 0px 15px;">
			<div class="block-grey1 ">

			<div class="col-sm-4">
						<div class="block-greyy1 block-numbery center">
							<img src="img/graph_0.svg" width="50px"/>
							<p class="number-feature-marches">{{Population}}</p>
							<p class="subtitle-number-feature">Population</p>
						</div>
					</div>
					<div class="col-sm-4">
						<div class="block-greyy1 block-numbery center">
							 <img src="img/graph_1.svg" width="50px"/>
							<p class="number-feature-marches">{{Etrangers}} </p>
							<p class="subtitle-number-feature">Etrangers</p>
						</div>
					</div><div class="col-sm-4">
						<div class="block-greyy1 block-numbery center">
							<img src="img/graph_2.svg" width="50px"/> 

							<p class="number-feature-marches">{{superficie}} </p>
							<p class="subtitle-number-feature">Superficie</p>
						</div>
    
  </div>   
</div>
			 

</div>
</div>
<div class="acces-service-marches" style="">
<div class="btn-link-user">
<a href="commune.xlsx" target="_blank">
Learn more</a>
</div>
</div>
</div>

</div>

</li>

<style>

/* Définition des propriétés de style pour le service */
:root {
--mycolor:#161A30;
--mycolortheme5:#514367;
--myfont:'Inter', sans-serif;
}
/* */

#templateRight {
padding: 10px;
}

.title-feature {
color: var(--mycolor);
font-family: var(--myfont);
font-size: 19px;
line-height: 1.2;
font-weight: 700;
}

.subtitle-feature {
color: var(--mycolor);
font-family:var(--myfont);
font-size:18px;
margin-top:7%;
line-height:1;
}

.text-feature, p {
font-family:var(--myfont);
color:#555;
font-size:13px;
}

.center{
text-align:center;
}

.block-grey {
border-radius: 10px;
background-color: #e2e2e28f;
height: 250px;
}
.block-grey1 {
border-radius: 10px;
background-color: #e2e2e28f;
height: 180px;
}
.block-number{
padding: 50px 10px;
}

.block-graph{
padding: 25px 15px;
}

.block-greyy {
border-radius: 10px;
background-color: #e2e2e28f;
height: 120px;
}
.block-greyy1 {
border-radius: 10px;
background-color: #e2e2e28f;
height: 180px;
}
.block-numbery{
padding: 20px 10px;
}

.block-graphy{
padding: 25px 15px;
}

/* Critères de selection des entités */

span.select-features {
background-color: var(--mycolor);
padding: 5px 10px;
color: white;
font-size: 11px;
font-family: var(--myfont);
border-radius: 12px;
}

/* Message d'alerte sur la validité des informations */

p.warning {
font-size: 11px!important;
font-style: italic!important;
font-weight: 500!important;
margin: 10px 0px;
}

.warning-info2019, .warning-info2020 {
display:none;
}

.warning-info2021{
display:block;
}

/* Affichage du contenu selon usagers O/N */
#user-OUI .user-service-non {
display:none;
}

#user-NON .user-service-oui {
display:none;
}

/* Mise en fome USER-OUI */

.user-service-oui {
padding: 30px 0px;
}

.service-block-marches {
background-color: var(--mycolortheme5);
padding: 5%;;
border-radius: 10px;
}

.service-block-info {
padding: 0px 0px 0px 90px;
/* color: white!important; */
}

.user-service-oui .icon-block {
width: 60px;
padding: 12px;
background-color: #ffffff33;
border-radius: 15px;
position: absolute;
}

.service-block-info p {
color: white;
}

p.service-title {
font-size: 14px;
font-weight: 600;
padding: 10px 0px 0px;
margin: 0;
}

/* Numbers */

.service-block-number {
margin-top: 20px;
}

.number-feature-marches {
font-size: 24px;
font-weight: 600;
color: var(--mycolortheme5);
margin: 10px 0px 0px;
}

.title-number-feature-marches {
font-weight: 600;
color: var(--mycolortheme5);
margin:0;
}

.subtitle-number-feature {
font-size: 10px;
font-style: italic;
}

/* Chart */

p.title-chart-feature {
font-size: 12px;
font-weight: 600;
margin: 0;
}

/* Bouton en savoir plus */

.acces-service-marches {
text-align: center;
margin: 0 auto;
}

/* Mise en fome USER-NON */

.user-service-non {
text-align:center;
padding: 50px;
}

.user-service-non .icon-block-marches {
background-color: var(--mycolortheme5);
opacity: 0.8;
width: 60px;
border-radius: 15px;
padding: 12px;
margin: 0 auto;
}

h2.user-title-feature-marches {
font-weight: 600!important;
color: var(--mycolortheme5);
}

.btn-link-user {
margin:40px 0px;
}

.btn-link-user a{
font-family: var(--myfont);
border: solid 1px #161A30;
color: #161A30;
padding: 8px 12px;
border-radius: 8px;
margin: 40px 0px;
}

.btn-link-user a:hover {
background-color: #161A30;
color: white!important;
-webkit-transition: background-color 0.5s ease-out;
-moz-transition: background-color 0.5s ease-out;
-o-transition: background-color 0.5s ease-out;
transition: background-color 0.5s ease-out;
}

</style>


<script language="javascript">


// CHART 1 - Création d'un graphique de l'évolution des morts

// Définition des données statiques pour le nombre de morts par jour sur 7 jours
var deathsData = [10, 15, 20, 25, 30, 35, 40];

// Définition des dates pour les 7 jours
var dates = ['2023-09-08', '2023-09-09', '2023-09-10', '2023-09-11', '2023-09-12', '2023-09-13', '2023-09-14'];

// CRéation du graphique
var graph_deaths = {};

graph_deaths.getData = function () {
    var data = {
        chart_deaths: {
            labels: dates,
            data: {
                datasets: [deathsData]
            }
        }
    };
    console.log(data);
    graph_deaths.drawChart(data);
};

graph_deaths.drawChart = function (data) {
    var ctxDeaths = document.getElementById("graph_deaths");
    var ChartDeaths = new Chart(ctxDeaths, {
        type: 'line',
        data: {
            labels: data.chart_deaths.labels,
            datasets: [{
                label: "Nombre de morts",
                fill: 'origin',
                backgroundColor: "rgba(198, 40, 40,0.1)",
                borderColor: "rgba(198, 40, 40,0.9)",
                borderWidth: 1,
                borderRadius: 20,
                borderJoinStyle: 'round',
                hoverBorderJoinStyle: 'round',
                borderSkipped: false,
                barThickness: 10,
                pointRadius: 1,
                maxBarThickness: 20,
                tension: 0.3,
                hoverBackgroundColor: "rgba(77,121,184,0.2)",
                hoverBorderColor: "rgba(77,121,184,1)",
                data: data.chart_deaths.data.datasets[0]
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            scales: {
                x: {
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12,
                            lineHeight: 2,
                        }
                    },
                    grid: {
                        display: true
                    }
                },
                y: {
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    labels: {
                        font: {
                            family: 'Inter',
                            size: 11
                        }
                    }
                },
                tooltip: {
                    titleFont: {
                        family: 'Inter'
                    },
                    bodyFont: {
                        family: 'Inter',
                        size: 11
                    },
                    callbacks: {}
                }
            }
        }
    });
};

// CHART 2 - Création d'un graphique de l'évolution des blessés

// Définition des données statiques pour le nombre de blessés par jour sur 7 jours
var injuriesData = [4, 10, 20, 30, 40, 50, 60];

// CRéation du graphique
var graph_injuries = {};

graph_injuries.getData = function () {
    var data = {
        chart_injuries: {
            labels: dates,
            data: {
                datasets: [injuriesData]
            }
        }
    };
    console.log(data);
    graph_injuries.drawChart(data);
};

graph_injuries.drawChart = function (data) {
    var ctxInjuries = document.getElementById("graph_injuries");
    var ChartInjuries = new Chart(ctxInjuries, {
        type: 'line',
        data: {
            labels: data.chart_injuries.labels,
            datasets: [{
                label: "Nombre de blessés",
                fill: 'origin',
                backgroundColor: "rgba(77,121,184,0.1)",
                borderColor: "rgba(77,121,184,0.9)",
                borderWidth: 1,
                borderRadius: 20,
                borderJoinStyle: 'round',
                hoverBorderJoinStyle: 'round',
                borderSkipped: false,
                barThickness: 10,
                pointRadius: 1,
                maxBarThickness: 20,
                tension: 0.3,
                hoverBackgroundColor: "rgba(77,121,184,1)",
                hoverBorderColor: "rgba(77,121,184,1)",
                data: data.chart_injuries.data.datasets[0]
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: false,
            scales: {
                x: {
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12,
                            lineHeight: 2,
                        }
                    },
                    grid: {
                        display: true
                    }
                },
                y: {
                    ticks: {
                        font: {
                            family: 'Inter',
                            size: 12
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    labels: {
                        font: {
                            family: 'Inter',
                            size: 11
                        }
                    }
                },
                tooltip: {
                    titleFont: {
                        family: 'Inter'
                    },
                    bodyFont: {
                        family: 'Inter',
                        size: 11
                    },
                    callbacks: {}
                }
            }
        }
    });
};

// Création des nouveaux graphiques



$.get('https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.0.2/chart.min.js', function() {
    graph_deaths.getData();
graph_injuries.getData();
		});

</script>



{{/features}}