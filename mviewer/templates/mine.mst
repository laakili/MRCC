{{#features}}
<li class="item feature-card" id="templateRight">
  <div class="feature-header">
    <h3 class="title-feature">
      <i class="fas fa-map-marker-alt feature-icon"></i>
      {{nom_git}}
    </h3>
    <div id="select-features-list">
      <span class="select-features"><i class="fas fa-industry"></i> {{type}}</span>
      <span class="select-features"><i class="fas fa-layer-group"></i> {{categorie}}</span>
      <span class="select-features"><i class="fas fa-bolt"></i> {{secteur}}</span>
    </div>
    <div id="select-features-list">
      <span class="select-features tag-region"><i class="fas fa-map"></i> {{Reg}}</span>
    </div>
  </div>

  <div class="feature-details">
    <div class="detail-item">
      <i class="fas fa-microscope detail-icon"></i>
      <div>
        <span class="detail-label">Genèse</span>
        <span class="detail-value">{{genese}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-mountain detail-icon"></i>
      <div>
        <span class="detail-label">Morphologie</span>
        <span class="detail-value">{{morph}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-map detail-icon"></i>
      <div>
        <span class="detail-label">Nature Géologique</span>
        <span class="detail-value">{{nature}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-flask detail-icon"></i>
      <div>
        <span class="detail-label">Élément Principal</span>
        <span class="detail-value">{{princ_elm}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-atom detail-icon"></i>
      <div>
        <span class="detail-label">Substances</span>
        <span class="detail-value">{{pubst}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-gem detail-icon"></i>
      <div>
        <span class="detail-label">Minéraux Associés</span>
        <span class="detail-value">{{assoc}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-layer-group detail-icon"></i>
      <div>
        <span class="detail-label">Catégorie</span>
        <span class="detail-value">{{categ}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-eye detail-icon"></i>
      <div>
        <span class="detail-label">Observation</span>
        <span class="detail-value">{{obs}}</span>
      </div>
    </div>

    <div class="detail-item">
      <i class="fas fa-book detail-icon"></i>
      <div>
        <span class="detail-label">Bibliographie</span>
        <span class="detail-value">{{biblio}}</span>
      </div>
    </div>
  </div>

  <div class="source-footer">
    <i class="fas fa-database"></i>
    <span class="source-text">Source : Inventaire Minier National - GeoAI</span>
  </div>
</li>
{{/features}}

<style>
:root {
  --primary-color: #161A30;
  --secondary-color: #4D79B8;
  --accent-color: #5DB0C3;
  --light-bg: #F8F9FA;
  --dark-text: #2D3748;
  --light-text: #718096;
  --border-radius: 12px;
  --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  --font-family: 'Inter', sans-serif;
}

.item.feature-card {
  background-color: white;
  border-radius: var(--border-radius);
  box-shadow: var(--box-shadow);
  padding: 20px;
  margin-bottom: 20px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.item.feature-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
}

.feature-header {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px solid #e2e8f0;
}

.title-feature {
  color: var(--primary-color);
  font-family: var(--font-family);
  font-size: 1.25rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10px;
}

.feature-icon {
  color: var(--secondary-color);
  font-size: 1.1em;
}

#select-features-list {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.select-features {
  background-color: var(--primary-color);
  padding: 6px 12px;
  color: white;
  font-size: 0.75rem;
  border-radius: 20px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.feature-details {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 15px;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  background-color: var(--light-bg);
  border-radius: var(--border-radius);
}

.detail-icon {
  color: var(--secondary-color);
  font-size: 1.2em;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(77, 121, 184, 0.1);
  border-radius: 50%;
}

.detail-label {
  font-size: 0.75rem;
  color: var(--light-text);
  margin-bottom: 2px;
}

.detail-value {
  font-size: 0.9rem;
  color: var(--dark-text);
  font-weight: 500;
}

.source-footer {
  margin-top: 20px;
  padding-top: 15px;
  border-top: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--light-text);
}

.source-footer i {
  color: var(--secondary-color);
}

.tag-region {
  background-color: #1E90FF;
}
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
