{{#features}}
<li class="item feature-card" id="templateMarine">
  <div class="feature-header">
    <h3 class="title-feature">
      <i class="fas fa-water feature-icon"></i>
      {{Marregion}}
    </h3>
    <div id="select-features-list">
      <span class="select-features tag-eez"><i class="fas fa-globe"></i> {{EEZ}}</span>
      <span class="select-features tag-sea"><i class="fas fa-water"></i> {{IHO_SEA}}</span>
      <span class="select-features tag-country"><i class="fas fa-flag"></i> {{SOVEREIGN1}}</span>
    </div>
  </div>

  <div class="feature-details">
    <div class="detail-item"><i class="fas fa-flag detail-icon"></i>
      <div><span class="detail-label">Souverainté</span><span class="detail-value">{{SOVEREIGN1}} ( {{ISO_SOV1}} {{UN_SOV1}})</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-flag detail-icon"></i>
      <div><span class="detail-label">Territoire</span><span class="detail-value">{{TERRITORY1}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-ruler-combined detail-icon"></i>
      <div><span class="detail-label">Superficie (km²)</span><span class="detail-value">{{AREA_KM2}}</span></div>
    </div>


    <div class="detail-item"><i class="fas fa-hashtag detail-icon"></i>
      <div><span class="detail-label">MRGID Souverainté</span><span class="detail-value">{{MRGID_SOV1}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-hashtag detail-icon"></i>
      <div><span class="detail-label">MRGID Territoire</span><span class="detail-value">{{MRGID_TER1}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-hashtag detail-icon"></i>
      <div><span class="detail-label">MRGID EEZ</span><span class="detail-value">{{EEZ_MRGID}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-hashtag detail-icon"></i>
      <div><span class="detail-label">MRGID IHO</span><span class="detail-value">{{IHO_MRGID}}</span></div>
    </div>

    <div class="detail-item"><i class="fas fa-layer-group detail-icon"></i>
      <div><span class="detail-label">MRGID Combiné</span><span class="detail-value">{{\MRGID_COMB}}</span></div>
    </div>
  </div>
</li>



<style>
	/* Définition des variables CSS */
	:root {
		--primary-color: #161A30;
		--secondary-color: #4D79B8;
		--accent-color: #5DB0C3;
		--light-bg: #F8F9FA;
		--dark-text: #2D3748;
		--light-text: #718096;
		--border-radius: 12px;
		--box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		--font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
	}

	/* Style général */
	.item.feature-card {
		background-color: white;
		border-radius: var(--border-radius);
		box-shadow: var(--box-shadow);
		padding: 20px;
		margin-bottom: 20px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.item.feature-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
	}

	.feature-header {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 20px;
		padding-bottom: 15px;
		border-bottom: 1px solid #e2e8f0;
	}

	.title-feature {
		color: var(--primary-color);
		font-family: var(--font-family);
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.feature-icon {
		color: var(--secondary-color);
		font-size: 1.1em;
	}

	#select-features-list {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.select-features {
		background-color: var(--primary-color);
		padding: 6px 12px;
		color: white;
		font-size: 0.75rem;
		font-family: var(--font-family);
		border-radius: 20px;
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.select-features i {
		font-size: 0.7em;
	}

	.feature-details {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 15px;
	}

	.detail-item {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px;
		background-color: var(--light-bg);
		border-radius: var(--border-radius);
	}

	.detail-icon {
		color: var(--secondary-color);
		font-size: 1.2em;
		width: 30px;
		height: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: rgba(77, 121, 184, 0.1);
		border-radius: 50%;
	}

	.detail-label {
		display: block;
		font-family: var(--font-family);
		font-size: 0.75rem;
		color: var(--light-text);
		margin-bottom: 2px;
	}

	.detail-value {
		display: block;
		font-family: var(--font-family);
		font-size: 0.9rem;
		color: var(--dark-text);
		font-weight: 500;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.feature-details {
			grid-template-columns: 1fr;
		}
	}

	/* Ajout des animations */
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.feature-card {
		animation: fadeIn 0.4s ease-out forwards;
	}
	.source-footer {
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--light-text);
}

.source-footer i {
    color: var(--secondary-color);
}
.tag-region {
  background-color: #1E90FF; /* Bleu clair */
}

.tag-province {
  background-color: #20B2AA; /* Vert-bleu */
}

.tag-commune {
  background-color: #FF8C00; /* Orange foncé */
}

.tag-eez {
  background-color: #2b8cbe; /* bleu océan */
}

.tag-sea {
  background-color: #74c476; /* vert mer */
}

.tag-country {
  background-color: #fdae6b; /* orange doux */
}
</style>

<!-- Inclure Font Awesome pour les icônes -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script language="javascript">
  // Votre code JavaScript existant peut rester inchangé
  // Récupération du code_geo de l'entité selectionnée
  var c_geo = [];
  c_geo.push('Abrera');

  // Définition d'une fonction get_wfsdata
  function get_wfsdata(url, args, callback) {
    var qs = {
      "service": "WFS",
      "version": "2.0.0",
      "request": "GetFeature",
      "outputFormat": "application/json"
    };
    $.getJSON(url + $.param($.extend(qs, args)), callback);
  }


</script>

{{/features}}