# Copier ce fichier vers ".env" et renseigner les vraies valeurs.
# ".env" ne doit JAMAIS être commité (il est dans .gitignore).

# --- Flask ---
FLASK_SECRET_KEY=change-moi
FLASK_APP_SECRET_KEY=change-moi-aussi

# --- Base de données PostgreSQL ---
# Pour la stack docker-compose autonome, DB_HOST doit être "db" (nom du service).
DB_HOST=db
DB_PORT=5432
DB_NAME=geoportal
DB_USER=postgres
DB_PASSWORD=change-moi

# --- Email (Flask-Mail) ---
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- GeoServer ---
GEOSERVER_URL=http://geoai-solutions.ddns.net:8888/georisque
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=change-moi

# --- URL publique de l'app (liens dans les emails) ---
BASE_URL=http://localhost:5052/
